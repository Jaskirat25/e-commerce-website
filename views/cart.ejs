<%- include('header') %>
<div class="flex flex-col md:flex-row w-full h-screen px-10 py-5 gap-10 bg-gray-100">
    <!-- Products List -->
    <div class="w-full md:w-2/3 bg-white rounded-md shadow-lg p-5 overflow-auto">
        <h2 class="text-2xl font-semibold mb-5">Your Cart</h2>
        
        <!-- Grid layout for 2 products per row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <% user.cart.forEach(function(item) { %>
            <div class="flex flex-col items-start border rounded-lg overflow-hidden shadow-md bg-white">
                <div class="w-full h-56 bg-[<%=item.bgcolor%>] flex items-center justify-center rounded-md">
                    <!-- Base64 encoded image -->
                    <script>
                        var base64String = "<%= item.image.toString('base64') %>";
                        document.write('<img src="data:image/jpeg;base64,' + base64String + '" class="object-contain w-full h-full rounded-md" alt="<%= item.name %>"/>');
                    </script>
                </div>
                <div class="w-full p-4 bg-[<%=item.panelcolor%>]">
                    <h3 class="text-white font-semibold mb-2"><%= item.name %></h3>
                    <div class="flex items-center justify-between">
                        <h4 class="text-white font-bold">₹ <%= item.price %></h4>
                        <div class="flex items-center gap-2">
                            <button class="w-7 h-7 bg-white rounded-full flex items-center justify-center border">
                                <a class="ri-add-line" href=""></a>
                            </button>
                            <span class="px-2 py-1 rounded-md bg-gray-200 text-black">01</span>
                            <button class="w-7 h-7 bg-white rounded-full flex items-center justify-center border">
                                <i class="ri-subtract-line"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </div>

    <!-- Price Breakdown -->
    <div class="w-full md:w-1/3 bg-white rounded-md shadow-lg p-5">
        <h3 class="text-xl font-semibold mb-3">Price Breakdown</h3>
        <div class="mt-5">
            <div class="flex justify-between mt-2">
                <h4>Total MRP</h4>
                <h4>₹ <%=sum%></h4>
            </div>
            <div class="flex justify-between mt-2">
                <h4>Discount on MRP</h4>
                <h4>₹ 0</h4>
            </div>
            <div class="flex justify-between mt-2">
                <h4>Platform Fee</h4>
                <h4>₹ 20</h4>
            </div>
            <div class="flex justify-between mt-2">
                <h4>Shipping Fee</h4>
                <h4>FREE</h4>
            </div>
        </div>
        <div class="w-full h-[1px] bg-gray-300 my-5"></div>
        <div class="flex justify-between font-semibold">
            <h3 class="text-xl">Total Amount</h3>
            <h3 class="text-xl text-green-600">₹ <%=totalsum%></h3>
        </div>
        <button class="w-full mt-5 bg-green-600 text-white rounded-md py-2 font-semibold">Proceed to Checkout</button>
    </div>
</div>
<%- include('footer') %>
