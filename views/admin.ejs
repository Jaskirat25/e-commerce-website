<%- include('header') %>
<div class="w-full h-screen flex items-start px-10 py-10 bg-gray-50">
    <div class="w-[20%] h-screen flex flex-col items-start p-5 bg-white shadow-lg">
        <div class="flex flex-col gap-3">
            <a class="block w-fit mb-2 text-lg text-gray-600 font-medium hover:text-gray-800" href="/ownerRoute/admin">All Products</a>
            <a class="block w-fit mb-2 text-lg text-gray-600 font-medium hover:text-gray-800" href="/ownerRoute/products">Create new product</a>
        </div>
    </div>

    <div class="w-[80%] flex flex-wrap gap-6 p-5 overflow-y-auto">
        <a class="text-red-500 font-bold text-lg hover:underline mb-5" href="/ownerRoute/deleteAll">Delete all</a> <!-- Updated delete all link -->
        <% products.forEach(function(p) { %>
        <div class="w-[22%] p-4 bg-[<%=p.panelcolor%>] shadow-lg rounded-lg hover:shadow-xl transition transform hover:scale-105">
            <div class="w-full bg-[<%=p.bgcolor%>] rounded-lg flex items-center justify-center overflow-hidden">
                <!-- Image with controlled size -->
                <img src="data:image/jpeg;base64,<%= p.image.toString('base64') %>" alt="Product Image" class="w-full h-32 object-contain"/>
            </div>
            <div class="px-4 py-3">
                <h3 class="text-lg font-semibold text-[<%=p.textcolor%>]"><%= p.name %></h3>
                <h4 class="text-[<%=p.textcolor%>]">₹ <%= p.price %></h4>

                <!-- Edit and Delete buttons -->
                <div class="flex justify-between mt-4">
                    <!-- Edit Button (links to the edit route) -->
                    <a href="/ownerRoute/edit/<%= p._id %>" class="w-[48%] py-2 bg-blue-500 text-white text-center rounded-lg hover:bg-blue-600">Edit</a>

                    <!-- Delete Button (inside a form to handle POST request) -->
                    <form action="/ownerRoute/delete/<%= p._id %>" method="POST" class="w-[48%]">
                        <button type="submit" class="w-full py-2 bg-red-500 text-white rounded-lg hover:bg-red-600">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>
<%- include('footer') %>
